generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  quantity    Int
  imageUrls    String[]
  category    String?
  sku String? @unique
  isActive Boolean @default(true)
  discount     Float?
  isOutOfStock Boolean @default(false)
  tags String[]
  brand String?
  slug String? @unique
  colorOptions String[]
  publishedAt DateTime?
  deletedAt DateTime?
  averageRating Float? @default(0.0)
  totalReviews  Int?   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  name String?
  role Role @default(USER)
  profileImage String? 
  password String
}

enum Role {
  USER
  ADMIN
}